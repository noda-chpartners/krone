---
import Layout from "../layouts/Layout.astro";
import Rail from "../components/Rail.astro";
import Hero from "../components/Hero.astro";
import CoursePlate from "../components/CoursePlate.astro";
import Facts from "../components/Facts.astro";
import Access from "../components/Access.astro";
import ReserveMark from "../components/ReserveMark.astro";
import { courses } from "../data/salon";

const title = "エステティックサロンKrone【クローネ】｜豊田市永覚新町";
const description =
  "豊田市永覚新町のエステティックサロンKrone（クローネ）。痩身のフルコース、背中美人、セルライトケア、毎月1名の1ヶ月集中コース。末野原駅徒歩15分。平日・土曜10:00–23:00、日曜・祝日定休。";
---

<Layout title={title} description={description}>
  <Rail />
  <main class="page">
    <Hero />
    <CoursePlate course={courses[0]} />
    <CoursePlate course={courses[1]} />
    <CoursePlate course={courses[2]} />
    <Facts />
    <CoursePlate course={courses[3]} />
    <CoursePlate course={courses[4]} />
    <Access />
  </main>
  <ReserveMark />
</Layout>

<script>
  import { initMotion } from "../scripts/motion";
  initMotion();
</script>
